# Use npm run db:setup para configurar PostgreSQL local com credenciais geradas.
# Para PostgreSQL existente, configure conexões próprias, sem publicar credenciais.
DATABASE_URL="postgresql://USUARIO:SENHA@127.0.0.1:55432/unieventos"
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@127.0.0.1:55432/unieventos_test"
# Execute npm run auth:setup para gerar um segredo no .env, sem imprimi-lo.
# No deploy, use um segredo aleatório exclusivo no gerenciador de segredos do ambiente.
AUTH_SECRET=""
AUTH_URL="http://127.0.0.1:3000"
AUTH_EMAIL_DOMAINS="unisalesiano.com.br"
